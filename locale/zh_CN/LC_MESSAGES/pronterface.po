msgid ""
"Usage:\n"
"  printcore [OPTIONS] PORT FILE\n"
"\n"
"Options:\n"
"  -b, --baud=BAUD_RATE\t\tSet baud rate value. Default value is 115200\n"
"  -s, --statusreport\t\tPrint progress as percentage\n"
"  -v, --verbose\t\t\tPrint additional progress information\n"
"  -V, --version\t\t\tPrint program's version number and exit\n"
"  -h, --help\t\t\tPrint this help message and exit\n"
msgstr ""
"用法：\n"
"  printcore [OPTIONS] PORT FILE\n"
"\n"
"选项：\n"
"  -b, --baud=BAUD_RATE\t\t设置波特率，默认值为 115200\n"
"  -s, --statusreport\t\t显示百分比打印进度\n"
"  -v, --verbose\t\t\t显示更多进度信息\n"
"  -V, --version\t\t\t显示程序版本并退出\n"
"  -h, --help\t\t\t显示此帮助并退出\n"

#: printcore.py:69
msgid "Error: Port or gcode file were not specified.\n"
msgstr "错误：未指定端口或 G-Code 文件。\n"

#: printcore.py:75
msgid "Printing: %s on %s with baudrate %d"
msgstr "正在打印：%s，端口 %s，波特率 %d"

#: printcore.py:55
msgid "ValueError:"
msgstr "数值错误："

#: printcore.py:57
msgid "\tBAUD_RATE must be an integer\n"
msgstr "\tBAUD_RATE 必须为整数\n"

#: printcore.py:56
msgid "\tInvalid BAUD_RATE value '%s'"
msgstr "\t无效的 BAUD_RATE 值“%s”"

#: pronsole.py:28
msgid ""
"Usage:\n"
"  pronsole [OPTIONS] [FILE]\n"
"\n"
"Options:\n"
"  -h, --help\t\t\tPrint this help message and exit\n"
"  -V, --version\t\t\tPrint program's version number and exit\n"
"  -v, --verbose\t\t\tIncrease verbosity\n"
"  -c, --conf, --config=CONFIG_FILE\tLoad this file on startup instead of .pronsolerc; you may chain config files, if so settings auto-save will use the last specified file\n"
"  -e, --execute=COMMAND\t\tExecutes command after configuration/.pronsolerc is loaded; macros/settings from these commands are not autosaved"
msgstr ""
"用法：\n"
"  pronsole [OPTIONS] [FILE]\n"
"\n"
"选项：\n"
"  -h, --help\t\t\t显示此帮助并退出\n"
"  -V, --version\t\t\t显示程序版本并退出\n"
"  -v, --verbose\t\t\t显示更详细的信息\n"
"  -c, --conf, --config=CONFIG_FILE\t启动时加载指定文件以替代 .pronsolerc；可指定多个配置文件，设置自动保存到最后指定的文件\n"
"  -e, --execute=COMMAND\t\t加载配置/.pronsolerc 后执行命令；这些命令中的宏和设置不会自动保存"

#: pronsole.py:51
msgid "Caught an exception, exiting:"
msgstr "捕获到异常，正在退出："

#: pronterface.py:41
msgid ""
"Usage:\n"
"  pronterface [OPTIONS] [FILE]\n"
"\n"
"Options:\n"
"  -h, --help\t\t\tPrint this help message and exit\n"
"  -V, --version\t\t\tPrint program's version number and exit\n"
"  -v, --verbose\t\t\tIncrease verbosity\n"
"  -a, --autoconnect\t\tAutomatically try to connect to printer on startup\n"
"  -c, --conf, --config=CONFIG_FILE\tLoad this file on startup instead of .pronsolerc; you may chain config files, if so settings auto-save will use the last specified file\n"
"  -e, --execute=COMMAND\t\tExecutes command after configuration/.pronsolerc is loaded; macros/settings from these commands are not autosaved"
msgstr ""
"用法：\n"
"  pronterface [OPTIONS] [FILE]\n"
"\n"
"选项：\n"
"  -h, --help\t\t\t显示此帮助并退出\n"
"  -V, --version\t\t\t显示程序版本并退出\n"
"  -v, --verbose\t\t\t显示更详细的信息\n"
"  -a, --autoconnect\t\t启动时自动尝试连接打印机\n"
"  -c, --conf, --config=CONFIG_FILE\t启动时加载指定文件以替代 .pronsolerc；可指定多个配置文件，设置自动保存到最后指定的文件\n"
"  -e, --execute=COMMAND\t\t加载配置/.pronsolerc 后执行命令；这些命令中的宏和设置不会自动保存"

